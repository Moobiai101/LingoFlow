# LingoFlow runs offline unless live mode is explicitly selected.
LINGOFLOW_MODE=offline
HOST=0.0.0.0
PORT=3000
LINGOFLOW_DB_PATH=data/lingoflow.sqlite

# Required only for live provider connections.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# LINGOFLOW_PROVIDER_TIMEOUT_MS=12000
# LINGOFLOW_PROVIDER_RETRIES=2
# ELEVENLABS_WEBHOOK_SECRET=
# LINGOFLOW_TOOL_SECRET=
